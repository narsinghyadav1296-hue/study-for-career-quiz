# Copy this file to .env for local development (or set these as real
# environment variables in your hosting provider's dashboard, e.g. Render's
# "Environment" tab, for production). Never commit an actual .env file with
# real secrets.

# --- Database ---
# Leave empty for local development -> app automatically uses a local
# SQLite file (quiz_app.db). Set this to your PostgreSQL connection string
# in production -> app automatically switches to PostgreSQL. Render gives
# you this value directly on the Postgres instance's "Connect" tab
# (use the "External Database URL" if connecting from outside Render, or
# the "Internal Database URL" if the web service and database are in the
# same Render account/region).
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Required in production - random long string, keeps admin login sessions
# valid across restarts/deploys. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# One-time admin bootstrap (used only by `flask create-admin`).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- File storage ---
# "local" for development only (files are lost on every Render deploy -
# never use in production). "s3" for production - works with AWS S3
# directly, or Cloudflare R2 / Backblaze B2 / MinIO via S3_ENDPOINT_URL.
STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
